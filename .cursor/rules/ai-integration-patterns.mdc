## Processing Workflow

### Real-time Processing Hook
```typescript
// useDocumentProcessing hook pattern
const useDocumentProcessing = () => {
  const [isProcessing, setIsProcessing] = useState(false)
  const [finalResult, setFinalResult] = useState<string | null>(null)
  const [processedFiles, setProcessedFiles] = useState<ProcessedFileInfo[]>([])
  const [error, setError] = useState<string | null>(null)

  const startProcessing = async ({ userPrompt }: { userPrompt: string }) => {
    setIsProcessing(true)
    setError(null)
    
    try {
      const response = await fetch('/api/document-processing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userPrompt })
      })
      
      if (!response.ok) throw new Error('Processing failed')
      
      const data = await response.json()
      setFinalResult(data.result)
      setProcessedFiles(data.processedFiles || [])
    } catch (error) {
      setError(error.message)
    } finally {
      setIsProcessing(false)
    }
  }

  return {
    isProcessing,
    finalResult,
    processedFiles,
    error,
    startProcessing,
    stopProcessing: () => setIsProcessing(false),
    clearState: () => {
      setFinalResult(null)
      setProcessedFiles([])
      setError(null)
    }
  }
}
```


## Error Handling

### AI-Specific Error Handling
```typescript
const handleAIError = (error: Error) => {
  if (error.message.includes('rate limit')) {
    return 'AI service is busy. Please try again in a moment.'
  }
  
  if (error.message.includes('token limit')) {
    return 'Request is too long. Please try with a shorter prompt.'
  }
  
  if (error.message.includes('model not available')) {
    return 'AI service is temporarily unavailable. Please try again later.'
  }
  
  return 'An error occurred while processing your request.'
}
```

### Timeout Protection
```typescript
const processWithTimeout = async (promise: Promise<any>, timeoutMs: number) => {
  return Promise.race([
    promise,
    new Promise((_, reject) => 
      setTimeout(() => reject(new Error('Processing timeout')), timeoutMs)
    )
  ])
}
```


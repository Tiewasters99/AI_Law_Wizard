## Anti-Pattern Examples

### ❌ BAD: Skipping Layers

```typescript
// In route.ts - TOO MUCH in one place
export async function GET(request: NextRequest) {
  const session = await getServerSession(authOptions);
  if (!session)
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

  if (session.user.role !== "CUSTOMER") {
    return NextResponse.json({ error: "Forbidden" }, { status: 403 });
  }

  const data = await prisma.entity.findMany({
    where: { userId: session.user.id },
    include: { related: true },
    orderBy: { createdAt: "desc" },
  });

  return NextResponse.json({ success: true, data });
}
```

### ✅ GOOD: Proper Layering

```typescript
// route.ts
export async function GET(request: NextRequest) {
  return await handleListEntities(request);
}

// controller.ts
export async function handleListEntities(request: NextRequest) {
  try {
    await requireAuth(request);
    const entities = await listEntities();
    return successResponse({ entities });
  } catch (error) {
    return errorResponse(error);
  }
}

// service.ts
export async function listEntities() {
  return await findAllEntities();
}

// repository.ts
export async function findAllEntities() {
  return await prisma.entity.findMany({
    orderBy: { createdAt: "desc" },
  });
}
```

## Summary

**The Rule**: Every backend feature MUST follow the four-layer pattern. No shortcuts. No exceptions. This ensures maintainability, testability, and consistency across the entire application.

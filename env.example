# Environment variables for AI Wizard
# Add any configuration variables here as needed

# Azure AD Configuration for OneDrive Integration (OAuth Flow)
NEXT_PUBLIC_AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OneDrive Configuration
ONEDRIVE_ENABLED=true
ONEDRIVE_MAX_FILE_SIZE=104857600  # 100MB in bytes

# For more information, see the Next.js documentation:
# https://nextjs.org/docs/basic-features/environment-variables

# Next Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=123

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/ai_wizard_db"
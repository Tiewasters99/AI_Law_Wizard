# Environment variables for AI Wizard
# Add any configuration variables here as needed

# Azure AD Configuration for OneDrive Integration (OAuth Flow)
NEXT_PUBLIC_AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OneDrive Configuration
ONEDRIVE_ENABLED=true
ONEDRIVE_MAX_FILE_SIZE=104857600  # 100MB in bytes

# For more information, see the Next.js documentation:
# https://nextjs.org/docs/basic-features/environment-variables

# Next Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/ai_wizard_db"

# AI Model Configuration - OpenRouter (Unified LLM Access)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Legacy API Keys (Optional - kept for backward compatibility)
# GROK_API_KEY=your_grok_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration (for vector search)
PINE_CONE_API_KEY=your_pinecone_api_key_here
OPENAI_API_KEY=your_openai_api_key_for_embeddings

# PACER API Configuration (for Docket Genie)
# Official PACER API endpoints from documentation (May 2025)

# Mock Mode (for development without PACER API access)
# Set to 'true' to use simulated PACER data for development/testing
# Set to 'false' when you have real PACER API access
PACER_MOCK_MODE=true

# Production PACER endpoints (official from PACER API documentation)
# Authentication endpoint: pacer.login.uscourts.gov/services/cso-auth
# PCL API endpoint: pcl.uscourts.gov/pcl-public-api/rest
PACER_AUTH_DOMAIN=pacer.login.uscourts.gov
PACER_PCL_DOMAIN=pcl.uscourts.gov
PACER_TIMEOUT_MS=30000

# NYSD Court Configuration (Southern District of New York)

# QA/Testing PACER endpoints (for testing with test data, searches not billable)
# Register QA account at: https://qa-pacer.uscourts.gov
# PACER_AUTH_DOMAIN=qa-login.uscourts.gov
# PACER_PCL_DOMAIN=qa-pcl.uscourts.gov

# For testing with real PACER credentials:
# 1. Create a .env.local file (it's in .gitignore)
# 2. Register for PACER account:
#    - Production: https://pacer.uscourts.gov
#    - QA Testing: https://qa-pacer.uscourts.gov (free test data)
# 3. Set PACER_MOCK_MODE=false
# 4. Use QA endpoints for testing (not billable)
# 5. Switch to production endpoints when ready for real searches (billable)
# 6. See spec/PACER_INTEGRATION_TESTING.md for complete testing guide
# 
# NEVER commit real credentials to version control!
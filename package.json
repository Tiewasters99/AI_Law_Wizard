    "db:migrate": "npx prisma migrate dev",
    "copy-static-assets": "if exist public\\assets xcopy /E /I public\\assets dist\\public\\assets",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "npx prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:all": "npx prettier --write .",
    "format:check:all": "npx prettier --check .",

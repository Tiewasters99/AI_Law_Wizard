// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Embedding job to track file processing
model EmbeddingJob {
  id          String   @id @default(cuid())
  status      JobStatus @default(PENDING)
  fileName    String
  originalName String
  fileType    String
  fileSize    Int
  filePath    String?
  totalChunks Int      @default(0)
  processedChunks Int  @default(0)
  failedChunks Int     @default(0)
  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // OneDrive tracking fields
  isOneDriveFile Boolean @default(false)
  oneDriveId    String?  @unique // OneDrive file ID if synced from OneDrive
  oneDriveLastModified String? // OneDrive last modified date

  // Relations
  chunks EmbeddingChunk[]

  @@map("embedding_jobs")
}

// Individual chunks for detailed tracking
model EmbeddingChunk {
  id            String   @id @default(cuid())
  jobId         String
  chunkIndex    Int
  content       String   @db.Text
  contentLength Int
  status        ChunkStatus @default(PENDING)
  embeddingId   String?  // Pinecone vector ID
  summary       String?  @db.Text // Document summary for quick retrieval
  metadata      Json?    // Additional metadata for enhanced search
  error         String?
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  job EmbeddingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, chunkIndex])
  @@map("embedding_chunks")
}

// Chat sessions for tracking conversations
model ChatSession {
  id        String   @id @default(cuid())
  title     String?
  userId    String?  // Link to user for user-specific chats
  isActive  Boolean  @default(true)
  metadata  Json?    // Store additional context like system prompts, chat type, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentQueries DocumentQuery[]
  messages ChatMessage[]

  @@map("chat_sessions")
}

// Chat messages with enhanced LangChain support
model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  role        MessageRole
  content     String      @db.Text
  metadata    Json?       // Store LangChain message metadata, tool calls, etc.
  tokenCount  Int?        // Track token usage for billing
  modelUsed   String?     // Track which model was used
  createdAt   DateTime    @default(now())

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// Document Query History for tracking user queries and AI responses
model DocumentQuery {
  id              String   @id @default(cuid())
  userQuery       String   @db.Text
  aiResponse      String   @db.Text
  searchQuery     String?  // Optional search query used
  
  // Processing metadata
  success         Boolean  @default(true)
  error           String?  // Error message if failed
  confidence      Float?   // AI confidence score
  processingTime  Int?     // Processing time in milliseconds
  totalSteps      Int      @default(1)
  completedSteps  Int      @default(1)
  
  // Tool usage tracking
  toolsUsed       String[] // Array of tool names used
  filesProcessed  Json?    // Processed files info as JSON
  
  // User tracking (optional for future user auth)
  userId          String?
  sessionId       String?  // For grouping related queries
  chatSessionId   String?  // Link to chat session for enhanced functionality
  documentSessionId String?  // Link to document analysis session
  
  // Enhanced conversation context
  conversationContext Json?  // Store conversation context
  followUpQuestion Boolean @default(false) // Is this a follow-up question?
  parentQueryId   String?  // Reference to parent query for follow-ups
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  chatSession     ChatSession? @relation(fields: [chatSessionId], references: [id])
  documentSession DocumentAnalysisSession? @relation(fields: [documentSessionId], references: [id])
  parentQuery     DocumentQuery? @relation("QueryFollowUps", fields: [parentQueryId], references: [id])
  followUpQueries DocumentQuery[] @relation("QueryFollowUps")

  @@map("document_queries")
}

// Enhanced Chat Session for document analysis with mode tracking
model DocumentAnalysisSession {
  id        String   @id @default(cuid())
  userId    String?  // Link to user
  mode      ChatMode @default(QA) // QA or ACTION mode
  title     String?  // Session title
  context   Json?    // Store session context (relevant files, conversation state)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     DocumentAnalysisMessage[]
  queries      DocumentQuery[]
  fileContexts FileContext[]

  @@map("document_analysis_sessions")
}

// Enhanced Chat Messages for document analysis
model DocumentAnalysisMessage {
  id          String      @id @default(cuid())
  sessionId   String
  role        MessageRole
  content     String      @db.Text
  metadata    Json?       // Store file references, actions performed, etc.
  tokenCount  Int?        // Track token usage
  modelUsed   String?     // Track which model was used
  createdAt   DateTime    @default(now())

  // Relations
  session DocumentAnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("document_analysis_messages")
}

// File Context tracking for sessions
model FileContext {
  id              String   @id @default(cuid())
  sessionId       String
  fileId          String   // Reference to embedding job or file
  fileName        String
  chunksUsed      Json?    // Array of chunk indices used
  relevanceScore  Float?   // Relevance score for this file in context
  lastAccessed    DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relations
  session DocumentAnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("file_contexts")
}

// Enums
enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ChunkStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMode {
  QA
  ACTION
}

enum TransactionType {
  PURCHASE
  CONSUMPTION
  REFUND
  ADMIN_ADJUSTMENT
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model Blog {
  id String @id @default(cuid())
  title String
  content String @db.Text
  author String @default("Admin") // Blog author name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean @default(false)
  
  // Relations
  comments Comment[]
  
  @@map("blogs")
}

model Comment {
  id String @id @default(cuid())
  content String @db.Text
  authorName String
  authorEmail String?
  blogId String
  parentId String? // For nested replies
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  
  @@map("comments")
}


// Enums for User Roles
enum Role {
  CUSTOMER
  ATTORNEY
  ADMIN
}

// User model for authentication
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role      @default(CUSTOMER)
  profileComplete Boolean   @default(false)
  profileData     Json?     // Store additional profile information
  freeConsultationRequestsUsed Int @default(0) // Track free consultation requests used
  maxFreeConsultationRequests  Int @default(1) // Max free consultation requests allowed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  accounts                Account[]
  sessions                Session[]
  lawyerProfile           LawyerProfile?
  customerProfile         CustomerProfile?
  wallet                  Wallet?
  purchases               Purchase[]
  chatSessions            ChatSession[]
  documentAnalysisSessions DocumentAnalysisSession[]
  clientConsultationRequests ConsultationRequest[] @relation("ClientRequests")
  attorneyConsultationRequests ConsultationRequest[] @relation("AttorneyRequests")
  clientConversations     Conversation[] @relation("ClientConversations")
  attorneyConversations   Conversation[] @relation("AttorneyConversations")
  sentMessages            Message[] @relation("SentMessages")
  notifications           Notification[]

  @@map("users")
}

// Account model for next-auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model for next-auth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VerificationToken model for next-auth email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Profile for Lawyers
model LawyerProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  specialty        String? // e.g., "Corporate Law", "Criminal Law"
  barLicense       String? // Bar license number
  bio              String? @db.Text
  yearsOfExperience Int?
  firmName         String? // Law firm name
  verified         Boolean @default(false) // For future verification system

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lawyer_profiles")
}

// Profile for Customers
model CustomerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String?
  address     String?
  phone       String?
  industry    String? // Industry type
  needs       String? @db.Text // Legal needs description

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// Wallet model for token management
model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  tokens  Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TokenTransaction[]

  @@map("wallets")
}

// Token transactions for tracking token usage and purchases
model TokenTransaction {
  id          String            @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Int               // Positive for purchase, negative for consumption
  description String?
  reference   String?           // Payment intent ID or operation reference
  createdAt   DateTime          @default(now())

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("token_transactions")
}

// Token packages configuration for admin
model TokenPackage {
  id          String   @id @default(cuid())
  name        String
  tokens      Int
  priceInCents Int     // Price in cents (e.g., 1000 = $10.00)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  purchases Purchase[]

  @@map("token_packages")
}

// Purchase records for tracking Stripe payments
model Purchase {
  id                String       @id @default(cuid())
  userId            String
  packageId         String
  stripePaymentIntent String     @unique
  status            PurchaseStatus @default(PENDING)
  tokensAwarded     Int
  amountPaid        Int          // Amount in cents
  metadata          String?      // Additional metadata as JSON
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package TokenPackage @relation(fields: [packageId], references: [id])

  @@map("purchases")
}

// Consultation Request System Models

// Consultation request from client to attorney
model ConsultationRequest {
  id          String              @id @default(cuid())
  clientId    String
  attorneyId  String
  caseType    String              // Case type (Corporate, Criminal, Family, etc.)
  description String              @db.Text
  urgency     RequestUrgency      @default(MEDIUM)
  status      RequestStatus       @default(PENDING)
  documents   Json?               // Optional document references
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // Relations
  client       User         @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  attorney     User         @relation("AttorneyRequests", fields: [attorneyId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@map("consultation_requests")
}

// Conversation between client and attorney
model Conversation {
  id                    String   @id @default(cuid())
  consultationRequestId String   @unique
  clientId              String
  attorneyId            String
  lastMessageAt         DateTime @default(now())
  unreadByClient        Int      @default(0)
  unreadByAttorney      Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  consultationRequest ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  client              User                @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  attorney            User                @relation("AttorneyConversations", fields: [attorneyId], references: [id], onDelete: Cascade)
  messages            Message[]

  @@map("conversations")
}

// Individual message in conversation
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  attachments    Json?    // Optional file attachments
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Notification system
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  relatedId String?          // ID of related entity (request, message, etc.)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Enums for consultation request system
enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  NEW_REQUEST
  MESSAGE_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  REQUEST_CANCELLED
}



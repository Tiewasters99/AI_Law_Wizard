// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Embedding job to track file processing
model EmbeddingJob {
  id              String    @id @default(cuid())
  status          JobStatus @default(PENDING)
  fileName        String
  originalName    String
  fileType        String
  fileSize        Int
  filePath        String?
  totalChunks     Int       @default(0)
  processedChunks Int       @default(0)
  failedChunks    Int       @default(0)
  error           String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // User association
  userId String? // Link to user who uploaded the file

  // OneDrive tracking fields
  isOneDriveFile       Boolean @default(false)
  oneDriveId           String? @unique // OneDrive file ID if synced from OneDrive
  oneDriveLastModified String? // OneDrive last modified date

  // Relations
  user   User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks EmbeddingChunk[]

  @@map("embedding_jobs")
}

// Individual chunks for detailed tracking
model EmbeddingChunk {
  id            String      @id @default(cuid())
  jobId         String
  chunkIndex    Int
  content       String      @db.Text
  contentLength Int
  status        ChunkStatus @default(PENDING)
  embeddingId   String? // Pinecone vector ID
  summary       String?     @db.Text // Document summary for quick retrieval
  metadata      Json? // Additional metadata for enhanced search
  error         String?
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  job EmbeddingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, chunkIndex])
  @@map("embedding_chunks")
}

// Chat sessions for tracking conversations
model ChatSession {
  id        String   @id @default(cuid())
  title     String?
  userId    String? // Link to user for user-specific chats
  isActive  Boolean  @default(true)
  metadata  Json? // Store additional context like system prompts, chat type, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentQueries DocumentQuery[]
  messages        ChatMessage[]

  @@map("chat_sessions")
}

// Chat messages with enhanced LangChain support
model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  role       MessageRole
  content    String      @db.Text
  metadata   Json? // Store LangChain message metadata, tool calls, etc.
  tokenCount Int? // Track token usage for billing
  modelUsed  String? // Track which model was used
  createdAt  DateTime    @default(now())

  // Relations
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// Document Query History for tracking user queries and AI responses
model DocumentQuery {
  id          String  @id @default(cuid())
  userQuery   String  @db.Text
  aiResponse  String  @db.Text
  searchQuery String? // Optional search query used

  // Processing metadata
  success        Boolean @default(true)
  error          String? // Error message if failed
  confidence     Float? // AI confidence score
  processingTime Int? // Processing time in milliseconds
  totalSteps     Int     @default(1)
  completedSteps Int     @default(1)

  // Tool usage tracking
  toolsUsed      String[] // Array of tool names used
  filesProcessed Json? // Processed files info as JSON

  // User tracking (optional for future user auth)
  userId            String?
  sessionId         String? // For grouping related queries
  chatSessionId     String? // Link to chat session for enhanced functionality
  documentSessionId String? // Link to document analysis session

  // Enhanced conversation context
  conversationContext Json? // Store conversation context
  followUpQuestion    Boolean @default(false) // Is this a follow-up question?
  parentQueryId       String? // Reference to parent query for follow-ups

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chatSession     ChatSession?             @relation(fields: [chatSessionId], references: [id])
  documentSession DocumentAnalysisSession? @relation(fields: [documentSessionId], references: [id])
  parentQuery     DocumentQuery?           @relation("QueryFollowUps", fields: [parentQueryId], references: [id])
  followUpQueries DocumentQuery[]          @relation("QueryFollowUps")

  @@map("document_queries")
}

// Enhanced Chat Session for document analysis with mode tracking
model DocumentAnalysisSession {
  id        String   @id @default(cuid())
  userId    String? // Link to user
  mode      ChatMode @default(QA) // QA or ACTION mode
  title     String? // Session title
  context   Json? // Store session context (relevant files, conversation state)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     DocumentAnalysisMessage[]
  queries      DocumentQuery[]
  fileContexts FileContext[]

  @@map("document_analysis_sessions")
}

// Enhanced Chat Messages for document analysis
model DocumentAnalysisMessage {
  id         String      @id @default(cuid())
  sessionId  String
  role       MessageRole
  content    String      @db.Text
  metadata   Json? // Store file references, actions performed, etc.
  tokenCount Int? // Track token usage
  modelUsed  String? // Track which model was used
  createdAt  DateTime    @default(now())

  // Relations
  session DocumentAnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("document_analysis_messages")
}

// File Context tracking for sessions
model FileContext {
  id             String   @id @default(cuid())
  sessionId      String
  fileId         String // Reference to embedding job or file
  fileName       String
  chunksUsed     Json? // Array of chunk indices used
  relevanceScore Float? // Relevance score for this file in context
  lastAccessed   DateTime @default(now())
  createdAt      DateTime @default(now())

  // Relations
  session DocumentAnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("file_contexts")
}

// Enums
enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ChunkStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMode {
  QA
  ACTION
}

enum TransactionType {
  PURCHASE
  CONSUMPTION
  REFUND
  ADMIN_ADJUSTMENT
  CONSULTATION_REQUEST
  PROPOSAL_ACCEPTANCE
  MILESTONE_COMPLETION
  PROJECT_COMPLETION
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  author    String   @default("Admin") // Blog author name
  category  String? // Blog category (Corporate, Criminal, Family, etc.)
  tags      String[] @default([]) // Tags for filtering
  readTime  Int? // Estimated read time in minutes
  views     Int      @default(0) // View count
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean  @default(false)

  // Relations
  comments Comment[]

  @@map("blogs")
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  authorName  String
  authorEmail String?
  blogId      String
  parentId    String? // For nested replies
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  blog    Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

// Enums for User Roles
enum Role {
  CUSTOMER
  ATTORNEY
}

// User model for authentication
model User {
  id                           String    @id @default(cuid())
  name                         String?
  email                        String?   @unique
  emailVerified                DateTime?
  image                        String?
  password                     String?
  role                         Role      @default(CUSTOMER)
  profileComplete              Boolean   @default(false)
  profileData                  Json? // Store additional profile information
  freeConsultationRequestsUsed Int       @default(0) // Track free consultation requests used
  maxFreeConsultationRequests  Int       @default(1) // Max free consultation requests allowed

  // Profile fields
  phone    String?
  company  String?
  industry String?
  location String?
  bio      String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  // Relations
  accounts                     Account[]
  sessions                     Session[]
  lawyerProfile                LawyerProfile?
  customerProfile              CustomerProfile?
  wallet                       Wallet?
  purchases                    Purchase[]
  chatSessions                 ChatSession[]
  documentAnalysisSessions     DocumentAnalysisSession[]
  clientConsultationRequests   ConsultationRequest[]     @relation("ClientRequests")
  attorneyConsultationRequests ConsultationRequest[]     @relation("AttorneyRequests")
  clientConversations          Conversation[]            @relation("ClientConversations")
  attorneyConversations        Conversation[]            @relation("AttorneyConversations")
  sentMessages                 Message[]                 @relation("SentMessages")
  notifications                Notification[]
  tokenTransactions            TokenTransaction[]        @relation("UserTokenTransactions")
  embeddingJobs                EmbeddingJob[]
  attorneyProposals            Proposal[]                @relation("AttorneyProposals")
  clientProposals              Proposal[]                @relation("ClientProposals")
  clientProjects               Project[]                 @relation("ClientProjects")
  attorneyProjects             Project[]                 @relation("AttorneyProjects")
  reviewerReviews              Review[]                  @relation("ReviewerReviews")
  revieweeReviews              Review[]                  @relation("RevieweeReviews")

  @@map("users")
}

// Account model for next-auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// Session model for next-auth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// VerificationToken model for next-auth email verification
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Profile for Lawyers
model LawyerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  specialty         String? // e.g., "Corporate Law", "Criminal Law"
  barLicense        String? // Bar license number
  barNumber         String? // Bar number
  bio               String?  @db.Text
  yearsOfExperience Int?
  firmName          String? // Law firm name
  verified          Boolean  @default(false) // For future verification system
  location          String? // Attorney location
  practiceAreas     String[] @default([]) // Array of practice areas
  rating            Float? // Attorney rating (0-5)
  casesHandled      Int? // Number of cases handled
  availability      String? // Availability status
  hourlyRate        Float? // Hourly rate in dollars

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lawyer_profiles")
}

// Profile for Customers
model CustomerProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String?
  address     String?
  phone       String?
  industry    String? // Industry type
  needs       String? @db.Text // Legal needs description

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// Wallet model for token management
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // Token balance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TokenTransaction[]

  @@map("wallets")
}

// Token transactions for tracking token usage and purchases
model TokenTransaction {
  id          String          @id @default(cuid())
  walletId    String
  userId      String // User ID for easier querying
  type        TransactionType
  feature     String? // Feature name (document-assistant, wizard, grand-wizard, consultation-request, etc.)
  amount      Int // Positive for purchase, negative for consumption
  description String?
  reference   String? // Payment intent ID or operation reference
  projectId   String? // Link to project for milestone/project payments
  milestoneId String? // Link to milestone for milestone payments
  metadata    Json? // Additional metadata (operation details, sessionId, etc.)
  createdAt   DateTime        @default(now())

  // Relations
  wallet    Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user      User       @relation("UserTokenTransactions", fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([feature])
  @@index([userId, feature])
  @@index([projectId])
  @@index([milestoneId])
  @@map("token_transactions")
}

// Token packages configuration for admin
model TokenPackage {
  id          String   @id @default(cuid())
  name        String
  tokens      Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  purchases   Purchase[]
  RolePricing RolePricing[]

  @@map("token_packages")
}

// Purchase records for tracking Stripe payments
model Purchase {
  id                  String         @id @default(cuid())
  userId              String
  packageId           String
  stripePaymentIntent String         @unique
  status              PurchaseStatus @default(PENDING)
  tokensAwarded       Int
  amountPaid          Int // Amount in cents
  metadata            String? // Additional metadata as JSON
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  package TokenPackage @relation(fields: [packageId], references: [id])

  @@map("purchases")
}

// Consultation Request System Models

// Consultation request from client to attorney
model ConsultationRequest {
  id               String         @id @default(cuid())
  clientId         String
  attorneyId       String
  caseType         String // Case type (Corporate, Criminal, Family, etc.)
  description      String         @db.Text
  urgency          RequestUrgency @default(MEDIUM)
  status           RequestStatus  @default(PENDING)
  documents        Json? // Optional document references
  viewedByClient   Boolean        @default(false) // Track if client has viewed this request
  viewedByAttorney Boolean        @default(false) // Track if attorney has viewed this request
  proposalId       String?        @unique // Link to accepted proposal (one-to-one)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  client           User          @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  attorney         User          @relation("AttorneyRequests", fields: [attorneyId], references: [id], onDelete: Cascade)
  conversation     Conversation?
  acceptedProposal Proposal?     @relation("AcceptedProposal", fields: [proposalId], references: [id], onDelete: SetNull)
  proposals        Proposal[]    @relation("RequestProposals") // All proposals for this request
  projects         Project[]     @relation("RequestProjects") // Projects created from this request

  @@map("consultation_requests")
}

// Conversation between client and attorney
model Conversation {
  id                    String   @id @default(cuid())
  consultationRequestId String   @unique
  clientId              String
  attorneyId            String
  projectId             String?  @unique // Link to project if created from proposal (one-to-one)
  lastMessageAt         DateTime @default(now())
  unreadByClient        Int      @default(0)
  unreadByAttorney      Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  consultationRequest ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  client              User                @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  attorney            User                @relation("AttorneyConversations", fields: [attorneyId], references: [id], onDelete: Cascade)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages            Message[]

  @@map("conversations")
}

// Individual message in conversation
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  attachments    Json? // Optional file attachments
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Notification system
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  relatedId String? // ID of related entity (request, message, etc.)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Enums for consultation request system
enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestUrgency {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  NEW_REQUEST
  MESSAGE_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  PROPOSAL_RECEIVED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  MILESTONE_COMPLETED
  MILESTONE_APPROVED
  PROJECT_COMPLETED
}

model Admin {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  password     String // Required - no OAuth for admins
  image        String?
  isSuperAdmin Boolean   @default(false) // For future multi-level admin
  isActive     Boolean   @default(true) // Can deactivate admin
  lastLoginAt  DateTime?
  lastLoginIp  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  activityLogs AdminActivityLog[]

  @@map("admins")
}

model AdminActivityLog {
  id         String      @id @default(cuid())
  adminId    String
  action     AdminAction
  targetType String? // 'User', 'Feature', 'Package', etc.
  targetId   String? // ID of affected entity
  details    Json? // Additional context (before/after values, etc.)
  ipAddress  String?
  userAgent  String? // Browser/device information
  createdAt  DateTime    @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@map("admin_activity_logs")
}

enum AdminAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_PASSWORD_RESET
  FEATURE_TOGGLED
  FEATURE_CREATED
  PRICING_UPDATED
  PACKAGE_CREATED
  PACKAGE_UPDATED
  PACKAGE_DELETED
  TOKEN_ADJUSTMENT
  ROLE_PRICING_CREATED
  ROLE_PRICING_UPDATED
  FEATURE_PRICING_CREATED
  FEATURE_PRICING_UPDATED
  FEATURE_PRICING_DELETED
}

// Feature Management Models
model Feature {
  id           String          @id @default(cuid())
  name         String          @unique // e.g., 'attorney_wizard', 'client_directory'
  displayName  String // e.g., 'Document Analysis', 'Find Attorney'
  description  String? // Feature description for admin reference
  route        String // e.g., '/attorney/wizard', '/client/directory'
  category     FeatureCategory
  isGlobal     Boolean         @default(true) // Global on/off
  isEnabled    Boolean         @default(true) // Current enabled state
  roleSpecific FeatureRole[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("features")
}

model FeatureRole {
  id        String  @id @default(cuid())
  featureId String
  role      Role // ATTORNEY or CUSTOMER
  isEnabled Boolean @default(true)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, role])
  @@map("feature_roles")
}

enum FeatureCategory {
  DOCUMENT_PROCESSING
  LEGAL_RESEARCH
  DOCKET_GENIE
  INTEGRATIONS
  COMMUNICATION
  ANALYTICS
  CLIENT_MANAGEMENT
  RESOURCES
}

// Pricing Management Models
model RolePricing {
  id           String       @id @default(cuid())
  role         Role // ATTORNEY or CUSTOMER
  packageId    String
  priceInCents Int // Price for this role in cents (e.g., 1000 = $10.00)
  isActive     Boolean      @default(true)
  package      TokenPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([role, packageId])
  @@map("role_pricing")
}

// Feature pricing for token costs per action/feature
model FeaturePricing {
  id          String   @id @default(cuid())
  feature     String // e.g., 'document-assistant', 'wizard', 'grand-wizard', 'consultation-request'
  displayName String // e.g., 'Document Analysis', 'Legal Chat', 'Grand Wizard'
  tokens      Int // Token cost per use
  role        Role? // Optional: if null, applies to all roles. Otherwise role-specific pricing
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([feature, role])
  @@index([feature])
  @@index([role])
  @@map("feature_pricing")
}

// Marketplace Models

// Proposal from attorney to client
model Proposal {
  id                    String         @id @default(cuid())
  consultationRequestId String
  attorneyId            String
  clientId              String
  proposedFee           Int // Fee in tokens
  proposedTimeline      String // Timeline description (e.g., "2-3 weeks")
  description           String         @db.Text
  terms                 String?        @db.Text // Terms and conditions
  status                ProposalStatus @default(DRAFT)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  consultationRequest ConsultationRequest  @relation("RequestProposals", fields: [consultationRequestId], references: [id], onDelete: Cascade)
  acceptedProposal    ConsultationRequest? @relation("AcceptedProposal") // Accepted proposal relation
  attorney            User                 @relation("AttorneyProposals", fields: [attorneyId], references: [id], onDelete: Cascade)
  client              User                 @relation("ClientProposals", fields: [clientId], references: [id], onDelete: Cascade)
  project             Project?

  @@index([consultationRequestId])
  @@index([attorneyId])
  @@index([clientId])
  @@index([status])
  @@map("proposals")
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Project created from accepted proposal
model Project {
  id                    String        @id @default(cuid())
  consultationRequestId String
  proposalId            String        @unique
  clientId              String
  attorneyId            String
  title                 String
  description           String        @db.Text
  totalAmount           Int // Total tokens for the project
  status                ProjectStatus @default(ACTIVE)
  startDate             DateTime      @default(now())
  endDate               DateTime?
  contractUrl           String? // Optional contract document URL
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  consultationRequest ConsultationRequest @relation("RequestProjects", fields: [consultationRequestId], references: [id], onDelete: Cascade)
  proposal            Proposal            @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  client              User                @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  attorney            User                @relation("AttorneyProjects", fields: [attorneyId], references: [id], onDelete: Cascade)
  conversation        Conversation?
  milestones          Milestone[]
  reviews             Review[]
  disputes            Dispute[]
  tokenTransactions   TokenTransaction[]

  @@index([clientId])
  @@index([attorneyId])
  @@index([status])
  @@index([consultationRequestId])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

// Milestone within a project
model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  title         String
  description   String          @db.Text
  amount        Int // Tokens for this milestone
  status        MilestoneStatus @default(PENDING)
  dueDate       DateTime?
  completedDate DateTime?
  approvedDate  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  disputes          Dispute[]
  tokenTransactions TokenTransaction[]

  @@index([projectId])
  @@index([status])
  @@map("milestones")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  DISPUTED
}

// Review for completed project
model Review {
  id         String   @id @default(cuid())
  projectId  String
  reviewerId String // User who wrote the review
  revieweeId String // User being reviewed (attorney or client)
  rating     Int // 1-5 rating
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([projectId, reviewerId]) // One review per reviewer per project
  @@index([projectId])
  @@index([revieweeId])
  @@index([rating])
  @@map("reviews")
}

// Dispute for project or milestone
model Dispute {
  id          String        @id @default(cuid())
  projectId   String
  milestoneId String? // Optional: dispute specific milestone
  raisedBy    String // User ID who raised the dispute
  reason      String        @db.Text
  status      DisputeStatus @default(OPEN)
  resolution  String?       @db.Text
  resolvedBy  String? // Admin ID who resolved
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([raisedBy])
  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}
